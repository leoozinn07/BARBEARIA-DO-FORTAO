# Copie para .env e preencha. Nunca suba o .env para o GitHub.

NODE_ENV=production
PORTA=3000
# Endereço público do site, com https em produção (usado nos links dos e-mails)
APP_URL=https://barbeariadofortao.com.br
# Quantos proxies (Caddy, Nginx, Cloudflare) ficam na frente do Node
CONFIAR_PROXY=1

# Domínio (usado pelo Caddy para o HTTPS no docker compose)
DOMINIO=barbeariadofortao.com.br

# MySQL 8
MYSQL_HOST=127.0.0.1
MYSQL_PORTA=3306
MYSQL_USUARIO=fortao
MYSQL_SENHA=troque-esta-senha
# Só para o docker compose: senha do root do MySQL
MYSQL_SENHA_ROOT=troque-esta-senha-tambem
MYSQL_BANCO=fortao

# E-mail (SMTP de qualquer provedor: Brevo, Resend, Hostinger, Google Workspace...)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE="Barbearia do Fortão <contato@barbeariadofortao.com.br>"
# Recebe aviso de cada novo horário (além da conta admin)
EMAIL_ADMIN=

# Notificações push: gere com `npm run vapid`
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTATO=mailto:contato@barbeariadofortao.com.br

# App Android (Trusted Web Activity): pacote e impressão SHA-256 da chave de assinatura
TWA_PACOTE=br.com.barbeariadofortao.app
TWA_SHA256=

# Versões dos textos legais aceitos no cadastro (mude ao atualizar Termos/Privacidade)
VERSAO_TERMOS=2026-10-10
VERSAO_PRIVACIDADE=2026-10-10
