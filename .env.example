# Copie para .env e preencha. Nunca suba o .env para o GitHub.

NODE_ENV=production
PORTA=3000
# Endereço público do site, com https em produção (usado nos links dos e-mails)
APP_URL=https://barbeariadofortao.com.br
# Quantos proxies (Caddy, Nginx, Render, Railway, Cloudflare) ficam na frente do Node
CONFIAR_PROXY=1

# Domínio (usado pelo Caddy para o HTTPS no docker compose)
DOMINIO=barbeariadofortao.com.br

# Banco de dados no Supabase (projeto barbearia-do-fortao, região São Paulo)
# Copie o endereço exato em Supabase > Connect > Session pooler e troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.finqfiyylpkjsktjvcxa:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Certificado do Supabase para conferir a conexão criptografada
# (Database > Settings > SSL Configuration > Download certificate). Salve em certs/supabase-ca.crt
DATABASE_CA=certs/supabase-ca.crt
# Conexões abertas ao mesmo tempo (o plano grátis aguenta bem até 10)
DATABASE_CONEXOES=5

# E-mail (SMTP de qualquer provedor: Brevo, Resend, Hostinger, Google Workspace...)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE="Barbearia do Fortão <contato@barbeariadofortao.com.br>"
# Recebe aviso de cada novo horário (além da conta admin)
EMAIL_ADMIN=

# Versões dos textos legais aceitos no cadastro (mude ao atualizar Termos/Privacidade)
VERSAO_TERMOS=2026-10-10
VERSAO_PRIVACIDADE=2026-10-10
