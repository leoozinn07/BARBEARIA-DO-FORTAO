{
  "name": "barbearia-do-fortao",
  "version": "1.0.0",
  "private": true,
  "description": "Agendamento da Barbearia do Fortão (Cohab 5, São Paulo): site, app Android (PWA/TWA) e painel do admin.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node servidor/index.js",
    "dev": "node --watch servidor/index.js",
    "migrar": "node servidor/db/migrar.js",
    "semear": "node servidor/db/semear.js",
    "admin:criar": "node scripts/criar-admin.js",
    "vapid": "node scripts/gerar-vapid.js",
    "icones": "node scripts/gerar-icones.js",
    "test": "node --test --test-concurrency=1 \"testes/*.test.js\"",
    "lint": "eslint servidor publico/js scripts testes"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
